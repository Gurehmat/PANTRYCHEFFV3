##############################
# PantryCheff (Vite + React) #
##############################

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
output/

# Test coverage output
coverage/

# Vite / tooling caches
.vite/
*.tsbuildinfo
.eslintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime/local files
*.local

########################
# Environment / secrets #
########################

# Dotenv files (keep an example file trackable)
.env
.env.*
!.env.example
!.env.template

# Supabase CLI local state
supabase/.temp/

# Local debug / scratch outputs (keep out of git)
verification_result.json
debug_output.txt
models_list.json
payload.json

###################
# Editor / OS junk #
###################

# VS Code (keep useful workspace settings)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Cursor
.cursor/

# JetBrains
.idea/

# macOS / Windows
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Visual Studio / MSBuild
*.suo
*.user
*.userosscache
*.sln.docstates
*.njsproj
*.sln
*.vcxproj*
*.vsix
.vs/

# Vim swap files
*.sw?

#################
# Deploy tooling #
#################

# gh-pages local output (rare, but safe)
.cache/
